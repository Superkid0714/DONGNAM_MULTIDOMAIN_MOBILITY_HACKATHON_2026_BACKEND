# 공공데이터포털(data.go.kr) 일반 인증키
DATA_GO_KR_SERVICE_KEY=
# OpenAI 호환 LLM API 키
LLM_API_KEY=
# OpenAI 호환 LLM 엔드포인트 기본 URL
LLM_BASE_URL=https://api.openai.com/v1
# 사용할 LLM 모델 이름
LLM_MODEL_NAME=
# docker compose가 127.0.0.1에 노출할 호스트 포트
HOST_PORT=18103
# 변경 설명에 LLM 사용 여부 (false면 템플릿만)
EXPLAIN_USE_LLM=false
# true면 해수부 API 대신 저장된 스냅샷만 사용
OFFLINE_MODE=false
# true면 학습된 부산항 출항 지연 ML 모델을 사용 (모델/데이터 오류 시 통계 예측기로 대체)
FEATURE_P1_DELAY_ML=true
# 필요 시 모델 폴더 경로를 재정의. 기본값은 패키지의 forecast/ml 폴더
# DELAY_ML_MODEL_DIR=src/freshswitch_backend/forecast/ml
# 재최적화 계산 및 설명에 사용하는 요청 예산(초)
REPLAN_TIMEOUT_SECONDS=10
EXPLAIN_TIMEOUT_SECONDS=8
# 비어 있으면 전체 초기화 비활성화. 관리자는 Authorization: Bearer <토큰> 사용
DEMO_RESET_TOKEN=
# PostgreSQL 사용자 (compose db 컨테이너 최초 생성 때만 적용)
POSTGRES_USER=freshswitch
# PostgreSQL 비밀번호 (호스트에 포트를 열지 않음, 최초 생성 때만 적용)
POSTGRES_PASSWORD=freshswitch
# PostgreSQL 데이터베이스 이름
POSTGRES_DB=freshswitch
# 직접 지정할 DB 접속 URL (비우면 compose가 위 값으로 내부 db 접속 정보를 만든다. 특수문자 비밀번호도 그대로 쓴다)
DATABASE_URL=
